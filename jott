#!/usr/bin/env python3
import sys
import os
from datetime import datetime

# ======================================================================
# HOMEBREW SYSTEM ROUTING ENVIRONMENT
# ======================================================================
# When distributed via Homebrew, the entrypoint is symlinked globally, 
# while the underlying resource files live inside an internal 'libexec' folder.
# This injection snippet discovers the true physical location of this script 
# and appends it to Python's system path so imports resolve flawlessly.
CURRENT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.append(CURRENT_DIR)

from src import commands
from src.helpers import resolve_date


def flag_value(flags, name):
    """
    Reads '--name=value' or '--name value' out of a flag list.

    Returns None when the flag is absent, which stays distinct from an
    explicitly empty value -- 'jott jira setup --cloud-id ""' clears the
    setting, while omitting it leaves the setting alone.
    """
    prefix = f"--{name}="
    for i, arg in enumerate(flags):
        if arg.startswith(prefix):
            return arg[len(prefix):]
        if arg == f"--{name}":
            following = flags[i + 1] if i + 1 < len(flags) else None
            return "" if following is None or following.startswith("--") else following
    return None

def main():
    # Fallback to default behavior if no commands or strings are supplied
    if len(sys.argv) < 2:
        commands.show_status()
        commands.show_summary(datetime.now().strftime("%Y-%m-%d"))
        return
        
    cmd = sys.argv[1]
    
    # ======================================================================
    # CLI COMMAND ROUTING MATRIX
    # ======================================================================
    if cmd in ["help", "-h", "--help"]:
        commands.show_help()
        
    elif cmd == "edit":
        # Evaluates relative tokens ('yesterday') or defaults to today's stamp
        target_date = resolve_date(sys.argv[2]) if len(sys.argv) > 2 else datetime.now().strftime("%Y-%m-%d")
        commands.edit_ledger(target_date)
        
    elif cmd == "rewrite":
        # Bulk-replaces a day's entries from stdin. Used by the JottBar
        # menubar app's in-app editor; also usable from a shell pipeline.
        target_date = resolve_date(sys.argv[2]) if len(sys.argv) > 2 else datetime.now().strftime("%Y-%m-%d")
        commands.rewrite_ledger(target_date)

    elif cmd == "continue":
        # Captures the optional position ID row integer argument
        target_id = sys.argv[2] if len(sys.argv) > 2 else None
        commands.continue_previous_task(target_id)
        
    elif cmd == "backlog":
        # Handles user parameter validations for retroactive task logs
        if len(sys.argv) < 4:
            print("Error: Missing parameters. Use: jott backlog [minutes] \"task description\"")
            sys.exit(1)
        try:
            minutes = int(sys.argv[2])
        except ValueError:
            print("Error: Minutes parameter must be an integer.")
            sys.exit(1)
            
        # Reconstructs the task string description from remainder arguments
        message = " ".join(sys.argv[3:])
        from datetime import timedelta
        commands.log_task(message, custom_dt=(datetime.now() - timedelta(minutes=minutes)))
        
    elif cmd in ["view", "summary"]:
        # Direct structural sub-route evaluation for week matrix views
        if len(sys.argv) > 2 and sys.argv[2] == "week":
            modifier = sys.argv[3] if len(sys.argv) > 3 else None
            commands.show_weekly_summary(modifier)
        else:
            target_date = resolve_date(sys.argv[2]) if len(sys.argv) > 2 else datetime.now().strftime("%Y-%m-%d")
            commands.show_summary(target_date)
            
    elif cmd == "week":
        # Shorthand pass-through wrapper for 'jott view week'
        modifier = sys.argv[2] if len(sys.argv) > 2 else None
        commands.show_weekly_summary(modifier)
        
    elif cmd == "status":
        commands.show_status()
        
    elif cmd == "find":
        # Full-text search across every ledger on disk.
        if len(sys.argv) < 3:
            print('Error: Missing search text. Use: jott find "auth refactor"')
            sys.exit(1)
        flags = [a for a in sys.argv[3:] if a.startswith("--")]
        terms = [a for a in sys.argv[2:] if not a.startswith("--")]
        limit = 50
        if "--limit" in sys.argv:
            try:
                limit = int(sys.argv[sys.argv.index("--limit") + 1])
            except (IndexError, ValueError):
                print("Error: --limit needs a number.")
                sys.exit(1)
            terms = [t for t in terms if t != str(limit)]
        commands.find_entries(" ".join(terms), limit=limit, as_json="--json" in flags)

    elif cmd == "jira":
        # Jira integration. Subcommands are kept under one namespace so the
        # top-level catch-all still treats bare text as a task to log.
        sub = sys.argv[2] if len(sys.argv) > 2 else "status"
        flags = sys.argv[3:]
        if sub == "setup":
            # Site, account and cloud id. Interactive with no flags, and
            # scriptable with them -- which is how JottBar's Settings pane
            # writes config.toml without touching the file itself.
            commands.jira_setup(site=flag_value(flags, "site"),
                                email=flag_value(flags, "email"),
                                cloud_id=flag_value(flags, "cloud-id"),
                                as_json="--json" in flags)
        elif sub == "login":
            commands.jira_login(from_stdin="--stdin" in flags)
        elif sub == "logout":
            commands.jira_logout()
        elif sub == "status":
            commands.jira_status(as_json="--json" in flags)
        elif sub == "issues":
            commands.jira_issues(as_json="--json" in flags, force_refresh="--refresh" in flags)
        elif sub == "jql":
            # Everything that is not a flag is the query itself, so it works
            # quoted or bare: jott jira jql assignee = currentUser()
            words = [a for a in flags if not a.startswith("--")]
            query = " ".join(words) if words else None
            commands.jira_jql(query=query,
                              as_json="--json" in flags,
                              reset="--reset" in flags)
        else:
            print(f"Error: unknown jira subcommand '{sub}'. Try: setup, login, logout, status, issues, jql.")
            sys.exit(1)

    elif cmd == "sync":
        commands.sync_to_cloud()
        
    else:
        # Default Catch-All: If the token doesn't match a structural command, 
        # assume the user is logging a standard task directly (e.g., jott "task notes")
        commands.log_task(" ".join(sys.argv[1:]))

if __name__ == "__main__":
    main()
