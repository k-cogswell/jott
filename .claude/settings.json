{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(swift build:*)",
      "Bash(swift --version)",
      "Bash(python3 --version)",
      "Bash(python3 -m py_compile:*)",
      "Bash(xcode-select -p)",
      "Bash(./jott help)",
      "Bash(mktemp:*)"
    ],
    "ask": [
      "Bash(./install.sh:*)",
      "Bash(./uninstall.sh:*)",
      "Bash(codesign:*)",
      "Bash(defaults write:*)"
    ],
    "deny": [
      "Bash(jott sync:*)",
      "Bash(./jott sync:*)",
      "Bash(rclone:*)",
      "Bash(security:*)"
    ]
  }
}
